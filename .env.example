# Copy this file to ".env" and restart "npm run dev".
# On Vercel set the same names under Project -> Settings -> Environment Variables, then REDEPLOY
# (Vite reads them when the site is built).

# MediBridge backend (Express + MongoDB on Render)
VITE_API_URL=http://localhost:5000/api

# --- Ambulance Response Delay Prediction: the ML service (FastAPI) ---
# Local:      http://localhost:8000
# Production: https://YOUR-ML-SERVICE.onrender.com        (no trailing slash)
# Leave VITE_API_BASE_URL empty to use DEMO MODE (built-in estimate, no ML service needed).
VITE_API_BASE_URL=http://localhost:8000
VITE_PREDICT_PATH=/predict/response-delay
# VITE_USE_MOCK=true
